{
  "name": "plant-shop-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.17.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api dev",
    "build:web": "pnpm --dir apps/web build",
    "build:api": "pnpm --dir apps/api build",
    "dev:vite": "npm --prefix apps/legacy-vite run dev",
    "build:vite": "npm --prefix apps/legacy-vite run build",
    "lint": "pnpm -r lint"
  }
}
