NEXT_PUBLIC_APP_NAME=Plant Shop
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only API origin used by the Next.js admin login proxy.
API_URL=http://localhost:3001
# Must match apps/api/.env AUTH_SECRET; keep at least 32 random characters.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Configure ADMIN_EMAIL / ADMIN_PASSWORD only in apps/api/.env or the API host.
# Never expose administrator credentials in NEXT_PUBLIC_* variables.
